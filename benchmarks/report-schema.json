{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/daopingw/DEAPack/benchmarks/report-schema.json",
  "title": "DEAPack benchmark report",
  "type": "object",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {"schema_version": {"const": "1.1"}},
        "required": ["schema_version"]
      },
      "then": {"required": ["source_tree"]}
    },
    {
      "if": {
        "properties": {"schema_version": {"const": "1.0"}},
        "required": ["schema_version"]
      },
      "then": {"not": {"required": ["source_tree"]}}
    }
  ],
  "required": [
    "schema_version",
    "suite_id",
    "suite_status",
    "tier",
    "started_at",
    "finished_at",
    "manifest",
    "git",
    "environment",
    "configuration_errors",
    "selection",
    "summary",
    "cases"
  ],
  "properties": {
    "schema_version": {"enum": ["1.0", "1.1"]},
    "suite_id": {"type": "string", "minLength": 1},
    "suite_status": {
      "enum": [
        "passed",
        "passed_with_informational_failures",
        "failed",
        "configuration_error"
      ]
    },
    "tier": {"enum": ["smoke", "release"]},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "schema_version", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "schema_version": {"const": "1.0"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "source_tree": {"$ref": "#/$defs/source_tree"},
    "git": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "available",
        "revision",
        "branch",
        "dirty",
        "status_entry_count"
      ],
      "properties": {
        "available": {"type": "boolean"},
        "revision": {"type": ["string", "null"]},
        "branch": {"type": ["string", "null"]},
        "dirty": {"type": ["boolean", "null"]},
        "status_entry_count": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "environment": {
      "type": "object",
      "required": [
        "platform",
        "cpu",
        "memory",
        "python",
        "packages",
        "solver",
        "environment",
        "controlled_environment"
      ],
      "additionalProperties": false,
      "properties": {
        "platform": {"type": "object"},
        "cpu": {"type": "object"},
        "memory": {"type": "object"},
        "python": {"type": "object"},
        "packages": {"type": "object"},
        "solver": {"type": "object"},
        "environment": {"type": "object"},
        "controlled_environment": {"type": "object"}
      }
    },
    "configuration_errors": {
      "type": "array",
      "items": {"type": "string"}
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_ids", "blocking_only", "require_clean"],
      "properties": {
        "case_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string"}
        },
        "blocking_only": {"type": "boolean"},
        "require_clean": {"type": "boolean"}
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total",
        "passed",
        "failed",
        "timed_out",
        "runner_errors",
        "blocking_failures",
        "informational_failures"
      ],
      "properties": {
        "total": {"type": "integer", "minimum": 0},
        "passed": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0},
        "timed_out": {"type": "integer", "minimum": 0},
        "runner_errors": {"type": "integer", "minimum": 0},
        "blocking_failures": {"type": "integer", "minimum": 0},
        "informational_failures": {"type": "integer", "minimum": 0}
      }
    },
    "cases": {
      "type": "array",
      "items": {"$ref": "#/$defs/case"}
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "log": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "bytes": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "source_file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?!.*(?:^|/)\\.\\.?(?:/|$)).+$"
        },
        "bytes": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "source_tree": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format_version",
        "hash_algorithm",
        "aggregate_format",
        "sha256",
        "file_count",
        "total_bytes",
        "source_changed_during_run",
        "verified_unchanged_after_run",
        "observed_after_run_sha256",
        "scope",
        "runtime_import",
        "files"
      ],
      "properties": {
        "format_version": {"const": "1.0"},
        "hash_algorithm": {"const": "sha256"},
        "aggregate_format": {"const": "deapack-source-tree-sha256-v1"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "file_count": {"type": "integer", "minimum": 1},
        "total_bytes": {"type": "integer", "minimum": 0},
        "source_changed_during_run": {"type": "boolean"},
        "verified_unchanged_after_run": {"type": "boolean"},
        "observed_after_run_sha256": {
          "oneOf": [
            {"$ref": "#/$defs/sha256"},
            {"type": "null"}
          ]
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["included", "excluded"],
          "properties": {
            "included": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            },
            "excluded": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            }
          }
        },
        "runtime_import": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "expected_package_root",
            "resolved_init_path",
            "verified",
            "error"
          ],
          "properties": {
            "expected_package_root": {"const": "src/deapack"},
            "resolved_init_path": {"type": ["string", "null"]},
            "verified": {"type": "boolean"},
            "error": {"type": ["string", "null"]}
          }
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/source_file"}
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "script",
        "script_sha256",
        "blocking",
        "tier",
        "status",
        "command",
        "command_display",
        "timeout_seconds",
        "started_at",
        "finished_at",
        "wall_seconds",
        "peak_rss_bytes",
        "return_code",
        "runner_error",
        "stdout",
        "stderr"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "script": {"type": "string", "minLength": 1},
        "script_sha256": {"$ref": "#/$defs/sha256"},
        "blocking": {"type": "boolean"},
        "tier": {"enum": ["smoke", "release"]},
        "status": {"enum": ["passed", "failed", "timeout", "runner_error"]},
        "command": {
          "type": "array",
          "minItems": 2,
          "items": {"type": "string"}
        },
        "command_display": {"type": "string", "minLength": 1},
        "timeout_seconds": {"type": "integer", "exclusiveMinimum": 0},
        "started_at": {"type": "string", "format": "date-time"},
        "finished_at": {"type": "string", "format": "date-time"},
        "wall_seconds": {"type": "number", "minimum": 0},
        "peak_rss_bytes": {"type": "integer", "minimum": 0},
        "return_code": {"type": ["integer", "null"]},
        "runner_error": {"type": ["string", "null"]},
        "stdout": {"$ref": "#/$defs/log"},
        "stderr": {"$ref": "#/$defs/log"}
      }
    }
  }
}
