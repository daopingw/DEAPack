msgid "Environmental productivity change"
msgstr "环境生产率变化"

#: ../../chapters/04-productivity/environmental-productivity-ml-common-reference.md:233
#: 6fad678bd0474d29b1081dea665a6f07
msgid "Operating-performance change"
msgstr "经营绩效变化"

#: ../../chapters/04-productivity/environmental-productivity-ml-common-reference.md:233
