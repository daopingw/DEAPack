#: ../../notation.md:1 8688d4f9ce434925b3df036ef0833e7e
msgid "Notation at a Glance"
msgstr "符号速查"

#: ../../notation.md:3 3f4e176e81964779a2f95d65110f6574
msgid ""
"This page is a reading aid, not a list to memorize before beginning the "
"book. Most chapters use only a small part of it and introduce any additional"
" symbols when they are needed. When reading an equation, first ask:"
msgstr "本页用于辅助阅读，不需要在开始读书之前逐项背诵。多数章节只会用到其中一小部分，其他符号也会在需要时介绍。阅读公式时，先问三个问题："

#: ../../notation.md:7 8328ddbf61b24c9e8eb78c315c8898ea
msgid "What is the organization required to preserve?"
msgstr "组织必须保留什么？"

#: ../../notation.md:8 a28df93ee0194e9c97dc313fa07e4f08
msgid "What may change in the performance comparison?"
msgstr "绩效比较中允许改变什么？"

#: ../../notation.md:9 ca8b77b7b09149528fee225187bfb62f
msgid "Which organizations and periods supply the benchmark?"
msgstr "哪些组织和时期提供标杆？"

#: ../../notation.md:11 7deac6a22f2b43c4add842560e5dd5ec
msgid "Those questions give the symbols their economic meaning."
msgstr "正是这些问题赋予符号以经济含义。"

#: ../../notation.md:13 b79fafee663b4938adc55df643fa4df4
msgid "Organizations, variables, and time"
msgstr "组织、变量与时间"

#: ../../notation.md cb237dd6a2f14c329f86ecae50ae9d55
msgid "Symbol"
msgstr "符号"

#: ../../notation.md 592177c61e644f989ebdea57a6a2cc02
msgid "Meaning"
msgstr "含义"

#: ../../notation.md b4b00dcd81114fea941af1a88fa74b87
msgid "$j=1,\\ldots,n$"
msgstr "$j=1,\\ldots,n$"

#: ../../notation.md d1a172fa621f40d896179859643c8e2f
msgid "an organization in the reference sample"
msgstr "参照样本中的一个组织"

#: ../../notation.md 17883dbc408746c7b4b6a5f3ce08f553
msgid "$o$"
msgstr "$o$"

#: ../../notation.md 63fbdb2070694c3b8e11cac322e54516
msgid "the organization currently being evaluated"
msgstr "当前接受评价的组织"

#: ../../notation.md 2fa2e38d3f14485c852aa41e3f5fe669
msgid "$i=1,\\ldots,m$"
msgstr "$i=1,\\ldots,m$"

#: ../../notation.md 8ed14af4311b47b382073e0e8b5720f4
