        "metadata_contract"
      ],
      "locators": [
        "tests/test_revenue.py",
        "tests/test_revenue_postsolve_certification.py"
      ]
    },
    "benchmarks": [
      "benchmarks/benchmark_economic_allocative.py"
    ]
  },
