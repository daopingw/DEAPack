  "title": "One-sided radial VRS scale elasticity",
  "decision_question": "At the selected Pareto-efficient VRS operating plan, by what percentage can the maximum proportional output bundle change when all resources change by one percent on the scale-up or scale-down side?",
  "names": {
    "display": "One-sided radial scale elasticity",
    "historical": [
      {
        "label": "Scale elasticity in a VRS DEA model",
        "spellings": [
          "DEA scale elasticity",
          "left- and right-hand scale elasticity"
        ],
        "sources": [
          "doi:10.1057/palgrave.jors.2601741",
          "doi:10.1016/j.ejor.2016.09.029"
        ]
      }
    ],
    "api": {
      "canonical_symbol": "scale_elasticity",
      "aliases": []
    },
    "spellings": [
      "radial scale elasticity",
      "one-sided scale response"
    ]
  },
