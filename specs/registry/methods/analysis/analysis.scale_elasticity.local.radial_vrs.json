        "kind": "selected_projection_support_transform",
        "projection_completion": "maximize_row_scaled_slacks",
        "projection_uniqueness": "not_assessed",
        "alternate_support_policy": "transform_full_interval_at_selected_target"
      }
    },
    "analysis": {
      "fixed": {
        "kind": "one_sided_scale_elasticity",
        "scope": "selected_projection",
        "support_sign_convention": "v'x-u'y+delta>=0",
        "output_formula": "epsilon_right=1-delta_upper;epsilon_left=1-delta_lower",
        "input_formula": "epsilon_right=1/(1+delta_upper);epsilon_left=1/(1+delta_lower)",
        "endpoint_order": "epsilon_right_le_epsilon_left",
        "aggregate_rts_rule": "banker_thrall_support_interval",
        "boundary_policy": "separate_extended_value_from_feasible_perturbation",
        "projection_invariance_claimed": false
      }
    },
