    },
    "invariance": {
      "unit": {
        "status": "conditional",
        "rule": "quantity_units_and_direction_components_must_co_transform_while_scalar_directional_distances_remain_invariant",
        "co_transform": [
          "input_direction",
          "output_direction"
        ],
        "conditions": [
          "condition.direction_units_co_transform_with_quantity_units"
        ]
      },
      "translation": {
        "status": "unsupported",
        "rule": "general_translation_without_direction_and_technology_proof",
        "co_transform": [],
        "conditions": []
      }
    },
    "target": {
      "feasibility": "each directional task must pass solver-neutral primal, bound, objective, KKT, complementarity, and strong-duality checks plus raw and published reconstruction in original physical units before a distance is released",
      "efficiency": "not_applicable_to_the_additive_productivity_change_indicator",
      "selection": "reported peer intensities are solver-selected coefficients above peer_tolerance; all four distance and additive-account certificates release the score independently, while peers additionally require all four thresholded physical accounts to reconstruct and do not constitute one joint projection",
      "conditions": [
        "condition.all_directional_distance_tasks_optimal",
        "condition.common_directional_scale"
      ]
    }
  },
