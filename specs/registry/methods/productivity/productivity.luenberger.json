      },
      "constraints": [
        "domain.productivity.nonnegative_desirable_quantities",
        "domain.productivity.positive_input_and_output_aggregates",
        "condition.adjacent_dmu_identifier_match",
        "condition.direction_units_comparable_across_observations_and_periods"
      ]
    },
    "technology": {
      "fixed": {
        "family": "two_contemporaneous_convex_envelopment_technologies",
        "free_disposal": true,
        "source_returns_to_scale": "crs",
