  "result_contract": {
    "scores": [
      {
        "id": "productivity_change",
        "direction": "positive_is_improvement",
        "efficient_value": 0.0,
        "usual_range": {
          "lower": null,
          "upper": null,
          "conditions": [
            "condition.all_directional_distance_tasks_optimal",
            "condition.common_directional_scale"
          ]
        }
      }
    ],
    "components": [
      "efficiency_change",
      "technical_change",
      "base_reference_change",
      "comparison_reference_change",
      "distance_base_on_base",
      "distance_comparison_on_base",
      "distance_base_on_comparison",
      "distance_comparison_on_comparison",
      "decomposition_residual",
      "score_valid_and_score_status",
      "four_distance_lp_certificate_summary",
      "raw_published_and_thresholded_peer_physical_account_certificates",
      "additive_account_certificate_and_residuals",
      "peer_valid_and_peer_status",
      "reported_peer_intensities_above_peer_tolerance",
      "direction_policy_labels_and_custom_parameter_signatures"
    ],
    "transformations": [
      "base_reference_change_equals_distance_base_on_base_minus_distance_comparison_on_base",
      "comparison_reference_change_equals_distance_base_on_comparison_minus_distance_comparison_on_comparison",
      "productivity_change_equals_one_half_times_base_reference_change_plus_comparison_reference_change",
      "productivity_change_equals_efficiency_change_plus_technical_change"
    ]
  },
  "guarantees": {
    "domain": {
      "status": "conditional",
      "conditions": [
        "domain.productivity.nonnegative_desirable_quantities",
