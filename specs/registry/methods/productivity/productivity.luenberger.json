          "comparison_on_base",
          "base_on_comparison",
          "comparison_on_comparison"
        ]
      },
      "defaults": {
        "comparison_population": {
          "scope": "one_contemporaneous_technology_per_period",
          "membership_rule": "all_eligible_observations_from_the_technology_period",
          "self_membership": "allowed_for_own_period_tasks"
        },
        "temporal_information_set": {
          "policy": "adjacent_contemporaneous",
          "availability_cutoff": "each_evaluated_technology_period",
