  "category": "productivity",
  "title": "Pastor--Lovell Global Malmquist productivity index",
  "decision_question": "How did radial productive performance change when every compared observation is measured against one retrospective full-sample production benchmark?",
  "names": {
    "display": "Pastor--Lovell Global Malmquist productivity index",
    "historical": [
      {
        "label": "Global Malmquist productivity index",
        "spellings": [
          "Global MPI",
          "Global Malmquist index"
        ],
        "sources": [
          "doi:10.1016/j.econlet.2005.02.013"
        ]
      }
    ],
    "api": {
      "canonical_symbol": "GlobalMalmquistProductivityIndex",
      "aliases": [
        {
          "symbol": "GlobalMalmquistDEA"
        }
      ]
    },
    "spellings": [
      "Pastor--Lovell global index",
      "full-sample common-reference Malmquist"
    ]
  },
  "composition": {
    "context": {
      "fixed": {
        "purpose": "retrospective_productivity_change_accounting",
        "time_comparison": "selected_forward_period_pairs_with_adjacent_default_within_one_fixed_global_sample_vintage",
        "managerial_interpretation": "operating_performance_change_and_change_in_proximity_of_contemporaneous_best_practice_to_the_full_sample_benchmark_at_the_evaluated_operating_mix"
      }
    },
    "graph": {
      "components": [
        "graph.black_box"
      ],
      "fixed": {
        "kind": "repeated_black_box",
        "temporal_links": "none"
      }
    },
    "data_roles": {
      "fixed": {
        "inputs": "productive_resource_quantities",
        "outputs": "desirable_service_or_product_quantities",
        "bad_outputs": "excluded",
        "panel_key": "matched_dmu_and_ordered_period",
        "representation": {
          "measurement_scale": "ratio",
          "sign_domain": "nonnegative_quantities_with_positive_observation_aggregates",
          "divisibility": "continuous",
          "observation_status": "exact",
          "controllability": "discretionary"
        }
      },
      "constraints": [
        "domain.productivity.nonnegative_desirable_quantities",
        "domain.productivity.positive_input_and_output_aggregates"
      ]
    },
    "technology": {
      "fixed": {
        "family": "contemporaneous_and_full_sample_pooled_convex_envelopment",
        "free_disposal": true,
        "global_pooling": "raw_observations_from_every_declared_sample_period",
        "source_returns_to_scale": "crs",
        "non_crs_interpretation": "sensitivity_specification_not_automatically_the_classic_total_factor_productivity_contract"
      },
      "defaults": {
        "returns_to_scale": "crs"
      },
      "exposed": [
        "returns_to_scale"
      ]
    },
    "estimator": {
      "components": [
        "estimator.full.dea"
      ],
      "fixed": {
        "kind": "full_frontier",
        "family": "dea_envelopment"
      }
    },
    "reference": {
      "components": [
        "reference.global",
        "reference.contemporaneous"
      ],
      "fixed": {
        "kind": "global_full_sample_and_own_period",
        "global_vintage": "entire_declared_sample",
        "distance_tasks_per_transition": [
          "base_on_base",
          "comparison_on_comparison",
          "base_on_global",
          "comparison_on_global"
        ]
      },
      "defaults": {
        "comparison_population": {
          "scope": "all_economically_eligible_observations",
          "membership_rule": "pooled_across_every_declared_sample_period",
          "self_membership": "allowed"
        },
        "temporal_information_set": {
          "policy": "global_retrospective",
          "availability_cutoff": "full_declared_sample",
          "vintage_required": true,
          "historical_revision": "all_global_distances_recomputed_when_the_sample_vintage_changes"
        }
      }
    },
    "performance": {
      "components": [
        "static.radial"
      ],
      "fixed": {
        "family": "radial_farrell_efficiency"
      },
      "defaults": {
        "orientation": "output"
      },
      "exposed": [
        "orientation"
      ]
    },
    "valuation": {
      "fixed": {
        "kind": "none"
      }
    },
    "evaluation_protocol": {
      "fixed": {
        "kind": "matched_selected_forward_period_pair_identifiers",
        "comparison_pair_contract": {
          "adjacent": "default_consecutive_pairs_in_declared_period_order",
          "all": "opt_in_all_forward_i_less_than_j_pairs_in_declared_period_order",
          "custom": "ordered_nonempty_sequence_of_unique_forward_base_and_comparison_period_pairs"
        },
        "unbalanced_scope": "applied_independently_to_each_selected_pair_without_shrinking_the_global_reference",
        "output_size": {
          "adjacent": "O(D_times_P)",
          "all": "O(D_times_P_squared)",
          "custom": "O(D_times_K_selected_pairs)"
        },
        "distance_solve_cache": "at_most_one_own_period_and_one_global_distance_per_observation_or_O(D_times_P)",
        "failure_policy": "missing_index_with_failed_distance_roles_preserved_per_selected_pair"
      },
      "defaults": {
        "unbalanced": "drop",
        "comparison_pairs": "adjacent"
      },
      "exposed": [
        "unbalanced",
        "comparison_pairs"
      ]
    },
    "analysis": {
      "fixed": {
        "kind": "global_malmquist_productivity",
        "productivity_identity": "global_efficiency_comparison_divided_by_global_efficiency_base",
        "decomposition": "productivity_change_equals_efficiency_change_times_best_practice_gap_change",
        "circularity": "within_one_fixed_global_sample",
        "pairwise_interpretation": "direct_change_between_the_selected_operating_dates_under_one_retrospective_benchmark_not_additional_causal_evidence",
        "source_interpretation_domain": "crs",
        "causal_interpretation": "not_claimed"
      }
    },
