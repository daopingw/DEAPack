        "status": "unsupported",
        "rule": "general_translation",
        "co_transform": [],
        "conditions": []
      }
    },
    "target": {
      "feasibility": "After both programmes are certified, every period target belongs to that period's contemporaneous technology under the declared CRS or period-specific VRS assumption and satisfies the fixed common radial requirement.",
      "efficiency": "The generic is_efficient flag is reported only after certified phase-two completion and is true only when the common radial factor equals one and every normalized input and output slack is zero.",
      "selection": "The phase-two target, peer intensities, and individual raw slacks are solver-selected members of a possibly non-unique raw-total-slack optimum and can change with variable units without changing the radial factor or zero-versus-positive slack classification.",
      "conditions": [
        "condition.phase_one_solution_certified",
        "condition.phase_two_solution_certified",
        "condition.fixed_common_factor_in_phase_two",
        "condition.period_specific_crs_or_vrs_feasibility"
      ]
    }
