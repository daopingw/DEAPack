      "normalized_slack_accounts",
      "solver_selected_period_targets",
      "period_specific_reference_intensities",
      "phase_one_and_phase_two_diagnostics",
      "target_selection_and_uniqueness_disclosure",
      "phase_two_failure_retains_only_certified_radial_performance"
    ],
    "transformations": [
      "input_efficiency_equals_common_theta",
      "output_efficiency_equals_reciprocal_common_phi",
      "full_efficiency_requires_common_factor_one_and_zero_normalized_total_slack"
    ]
  },
