  "result_contract": {
    "scores": [
      {
        "id": "multiperiod_aggregative_efficiency",
        "direction": "higher_is_better",
        "efficient_value": 1.0,
        "usual_range": {
          "lower": 0.0,
          "upper": 1.0,
          "conditions": [
            "condition.self_inclusive_reference",
            "condition.phase_one_solution_certified",
            "domain.multiperiod_aggregative.valid_balanced_panel"
          ]
        }
      },
      {
        "id": "input_common_theta",
        "direction": "higher_is_better",
        "efficient_value": 1.0,
        "usual_range": {
          "lower": 0.0,
          "upper": 1.0,
          "conditions": [
            "condition.orientation.input",
            "condition.self_inclusive_reference",
            "condition.phase_one_solution_certified"
          ]
        }
      },
      {
        "id": "output_common_phi",
        "direction": "lower_is_better",
        "efficient_value": 1.0,
        "usual_range": {
          "lower": 1.0,
          "upper": null,
          "conditions": [
            "condition.orientation.output",
            "condition.self_inclusive_reference",
            "condition.phase_one_solution_certified"
          ]
        }
      }
    ],
    "components": [
      "common_native_factor",
      "standard_efficiency",
      "radial_efficiency_status",
      "full_weak_inefficient_classification",
      "strong_completion_certification",
      "period_accounts_repeating_the_common_factor_not_period_efficiencies",
